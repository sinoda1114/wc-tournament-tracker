#!/usr/bin/env bash
# push 前の AI レビューゲート（グローバルの pre-push）を呼び継ぐ。
#
# scripts/setup-dev.sh は core.hooksPath を scripts/hooks にする（pre-commit で本体での commit を拒否するため）。
# すると git はグローバルの core.hooksPath（例: ~/.git-hooks）を見なくなり、そこにある
# /ai-review の pre-push ゲートが黙って止まる。ここからそのゲートを呼び、git が渡す引数（remote 名と URL）と
# 標準入力（push する ref の一覧）をそのまま渡す。
#
# ゲートが見つからないときは push を止める（黙って通さない）。回避はゲート自身の手段に従う:
#   AI_REVIEW_BYPASS=1 git push   （理由をコミットログか PR に残す）
set -euo pipefail

global_dir="$(git config --global --get core.hooksPath 2>/dev/null || true)"
case "$global_dir" in
  "~") global_dir="$HOME" ;;
  "~/"*) global_dir="$HOME/${global_dir#"~/"}" ;;
esac
gate="${global_dir:-$HOME/.git-hooks}/pre-push"

if [ ! -x "$gate" ]; then
  cat >&2 <<MSG
⛔ push 前ゲート（${gate}）が見つかりません。/ai-review の pre-push を導入してから push してください。
   導入: ~/.claude/skills/ai-review/hooks/pre-push を ~/.git-hooks/pre-push にコピーし、
         git config --global core.hooksPath ~/.git-hooks
MSG
  exit 1
fi
# グローバルの core.hooksPath がこのディレクトリを指していると、自分自身を呼び続ける。
if [ "$gate" -ef "$0" ]; then
  echo "⛔ グローバルの core.hooksPath が scripts/hooks を指しています（${gate}）。ゲートを呼べないため push を止めます。" >&2
  exit 1
fi

exec "$gate" "$@"
