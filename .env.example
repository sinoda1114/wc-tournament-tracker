TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# SEO 用の本番絶対 URL（末尾スラッシュ無し・スキーム込み）。
# sitemap / robots / OGP / canonical / JSON-LD の絶対 URL 生成に使う。
# 未設定時は Vercel の VERCEL_PROJECT_PRODUCTION_URL（本番のみ自動注入）を使い、
# それも無ければ lib/env.ts のフォールバック（example ドメイン）になる。
# 独自ドメイン確定後に必ず設定すること。
# 例: NEXT_PUBLIC_SITE_URL=https://wc2026.example.jp
NEXT_PUBLIC_SITE_URL=

# 試合結果の自動取り込み（Phase 2）
# TheSportsDB の API キー（任意）。未設定なら無料テストキー "3" を使う。
# 無料キーはレート制限が緩く、本番でも当面は十分。上位プラン化時にここを差し替える。
THESPORTSDB_KEY=
# /api/ingest を保護する秘密。Vercel Cron は CRON_SECRET 設定時に
# Authorization: Bearer <CRON_SECRET> を自動付与する。
# 重要: 未設定だと /api/ingest は常に 401（fail-closed）。本番では必ず設定すること。
# 生成例: openssl rand -hex 32
CRON_SECRET=
# 取り込み時に「当日からさかのぼって何日分」を取得するか（既定 3）。
# 日次→毎時 cron でも直近数日を取り直すことで、新たに終了した試合を冪等に拾う。
# 初回バックフィル時のみ大きめ（例 30）にして過去結果を一括取得し、その後 3 に戻す運用。
INGEST_WINDOW_DAYS=

# 会場の天気予報（#24）。WeatherAPI.com の API キー。
# 無料プランで商用利用可・10万コール/月・3日予報。登録時に自動発行される。
# 取得: https://www.weatherapi.com/my/
# 未設定でもサイトは動作する（天気表示だけ無効化する設計）。
WEATHER_API_KEY=

# 認証（Clerk）。ダッシュボードのアプリ keys。CLI なら `clerk env pull` で .env.local に自動取得。
# publishable はクライアント露出可（NEXT_PUBLIC_）。secret は絶対にクライアントへ出さない。
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# サインイン/アップのアプリ内ルート（(auth) ルートに固定）。
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# 管理者判定（カンマ区切りメール）。一致する Clerk ログインユーザーを admin とみなす。
# 旧 ADMIN_PASSWORD（password ベース）は廃止し、この allowlist に一本化した。
ADMIN_EMAILS=
